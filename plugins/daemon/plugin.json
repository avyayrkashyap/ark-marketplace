{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "daemon",
  "version": "0.1.0",
  "description": "Maintenance tools for plugin authors, starting with semver version bumps.",
  "author": {
    "name": "Avyay Kashyap",
    "url": "https://github.com/avyayrkashyap"
  },
  "repository": "https://github.com/avyayrkashyap/ark-marketplace",
  "license": "MIT",
  "keywords": ["semver", "versioning", "maintenance"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Daemon",
        "shortDescription": "Semver version bumps for plugins",
        "developerName": "Avyay Kashyap",
        "category": "Developer Tools",
        "defaultPrompt": ["Bump the version of the plugins I changed"]
      }
    }
  }
}
